package helper

import (
	"actor"
	"actor/broker/base"
	"actor/third/fixed"
	"actor/third/log"
	"testing"
	"time"
)

func TestReqLimit(t *testing.T) {
	/* --------------------------------------------------------------------------------------------------------- */
	// 准备工作
	var rsTest []base.Rs
	for _, pairString := range []string{"btc_usdt", "eth_usdt"} {
		pair, _ := StringPairToPair(pairString)
		rs := beastquant.GetRsClient(
			BrokernameBinanceUsdtSwap.String(),
			BrokerConfig{
				Pair: pair,
			},
			&TradeMsg{},
			&ExchangeInfo{},
			CallbackFunc{
				OnExit: func(msg string) {
					// 遇到限频会被调用
					log.Warnf("OnExit %s 限频测试失败", msg)
				},
			},
		)
		rs.BeforeTrade(HandleModePrepare)
		rsTest = append(rsTest, rs)
	}
	/* --------------------------------------------------------------------------------------------------------- */
	// 默认限频规则测试
	for _, rs := range rsTest {
		rule := GetReqLimit(BrokernameBinanceUsdtSwap.String())
		num := 0
		for {
			num += 1
			if num > 1000 {
				break
			}
			time.Sleep(time.Millisecond * time.Duration(rule.Mono.PlaceInterval))
			rs.SendSignal([]Signal{
				{
					Time:      0,
					Type:      0,
					ClientID:  "",
					OrderID:   "",
					Price:     0,
					Amount:    fixed.Fixed{},
					OrderSide: 0,
					OrderType: 0,
				},
			})
		}
	}
	/* --------------------------------------------------------------------------------------------------------- */
	// 极限挑战测试
	// step 1 测试单symbol 下单
	for _, v := range []float64{0.01, 0.1, 1, 10, 100, 1000} {
		log.Infof("测试单symbol 下单 %f", v)
		rule := ReqLimitRules{
			Mode: ReqLimitModeMono,
			Mono: ReqLimitRuleMono{
				PlaceNum:       0,
				PlaceInterval:  1000,
				CancelNum:      0,
				CancelInterval: 1000,
			},
			Share: ReqLimitRuleShare{},
			Range: ReqLimitRangeGlobal,
		}
		for _, rs := range rsTest {
			time.Sleep(time.Millisecond * time.Duration(rule.Mono.PlaceInterval))
			rs.SendSignal([]Signal{
				{
					Time:      0,
					Type:      0,
					ClientID:  "",
					OrderID:   "",
					Price:     0,
					Amount:    fixed.Fixed{},
					OrderSide: 0,
					OrderType: 0,
				},
			})
		}
	}
	// step 2 测试单symbol 撤单
	// step 3 测试单symbol 下单&撤单
	// step 4 测试双symbol 下单
	// step 5 测试双symbol 下单&撤单
}
